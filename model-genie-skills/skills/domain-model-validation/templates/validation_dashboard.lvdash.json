{
  "datasets": [
    {
      "name": "validation_run",
      "displayName": "Validation Runs",
      "queryLines": [
        "SELECT\n",
        "  Run_Id,\n",
        "  Project_Name,\n",
        "  Schema_Name,\n",
        "  Triggered_By,\n",
        "  Total_Entities,\n",
        "  Entities_Grade_A,\n",
        "  Entities_Grade_B_Plus,\n",
        "  Entities_Grade_B,\n",
        "  Entities_Grade_C_Or_Below,\n",
        "  Overall_Grade,\n",
        "  Drift_Alerts_Count,\n",
        "  Run_Duration_Seconds,\n",
        "  `_loaded_at`\n",
        "FROM\n",
        "  {silver_catalog}.{silver_schema}.`_validation_run`\n",
        "ORDER BY\n",
        "  Run_Timestamp DESC"
      ]
    },
    {
      "name": "gap_registry",
      "displayName": "Gap Registry",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  {silver_catalog}.{silver_schema}.`_gap_registry`\n",
        "ORDER BY\n",
        "  priority,\n",
        "  gap_id"
      ]
    },
    {
      "name": "table_result",
      "displayName": "Table Results",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  {silver_catalog}.{silver_schema}.`_validation_table_result`\n",
        "ORDER BY\n",
        "  run_id DESC,\n",
        "  table_name"
      ]
    },
    {
      "name": "check_detail",
      "displayName": "Check Details",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  {silver_catalog}.{silver_schema}.`_validation_check_detail`\n",
        "ORDER BY\n",
        "  run_id DESC,\n",
        "  table_name,\n",
        "  check_name"
      ]
    },
    {
      "name": "current_summary",
      "displayName": "Current Run Summary",
      "queryLines": [
        "WITH latest AS (\n",
        "  SELECT\n",
        "    run_id\n",
        "  FROM\n",
        "    {silver_catalog}.{silver_schema}.`_validation_run`\n",
        "  ORDER BY\n",
        "    Run_Timestamp DESC\n",
        "  LIMIT 1\n",
        ")\n",
        "SELECT\n",
        "  r.run_id,\n",
        "  r.Overall_Grade,\n",
        "  r.Run_Timestamp AS run_timestamp,\n",
        "  COUNT(DISTINCT t.table_name) AS total_entities,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN t.grade = 'A' THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS grade_a_count,\n",
        "  (\n",
        "    SELECT\n",
        "      COUNT(*)\n",
        "    FROM\n",
        "      {silver_catalog}.{silver_schema}.`_gap_registry`\n",
        "    WHERE\n",
        "      status = 'OPEN'\n",
        "  ) AS open_gaps,\n",
        "  (\n",
        "    SELECT\n",
        "      COUNT(*)\n",
        "    FROM\n",
        "      {silver_catalog}.{silver_schema}.`_gap_registry`\n",
        "    WHERE\n",
        "      status = 'DEFERRED'\n",
        "  ) AS deferred_gaps,\n",
        "  (\n",
        "    SELECT\n",
        "      COUNT(*)\n",
        "    FROM\n",
        "      {silver_catalog}.{silver_schema}.`_gap_registry`\n",
        "    WHERE\n",
        "      status = 'ACCEPTED'\n",
        "  ) AS accepted_gaps\n",
        "FROM\n",
        "  latest l\n",
        "    JOIN {silver_catalog}.{silver_schema}.`_validation_run` r\n",
        "      ON r.run_id = l.run_id\n",
        "    LEFT JOIN {silver_catalog}.{silver_schema}.`_validation_table_result` t\n",
        "      ON t.run_id = l.run_id\n",
        "GROUP BY\n",
        "  r.run_id,\n",
        "  r.Overall_Grade,\n",
        "  r.Run_Timestamp"
      ]
    },
    {
      "name": "scorecard",
      "displayName": "Scorecard",
      "queryLines": [
        "WITH latest AS (\n",
        "  SELECT\n",
        "    run_id\n",
        "  FROM\n",
        "    {silver_catalog}.{silver_schema}.`_validation_run`\n",
        "  ORDER BY\n",
        "    Run_Timestamp DESC\n",
        "  LIMIT 1\n",
        ")\n",
        "SELECT\n",
        "  t.table_name,\n",
        "  t.grade,\n",
        "  t.row_count,\n",
        "  t.pk_duplicate_count,\n",
        "  t.fk_orphan_rate_pct,\n",
        "  t.integration_pass,\n",
        "  t.known_gaps_count,\n",
        "  t.remediation_status\n",
        "FROM\n",
        "  latest l\n",
        "    JOIN {silver_catalog}.{silver_schema}.`_validation_table_result` t\n",
        "      ON t.run_id = l.run_id\n",
        "ORDER BY\n",
        "  t.table_name"
      ]
    },
    {
      "name": "integration_checks",
      "displayName": "Integration Checks",
      "queryLines": [
        "WITH latest AS (\n",
        "  SELECT\n",
        "    run_id\n",
        "  FROM\n",
        "    {silver_catalog}.{silver_schema}.`_validation_run`\n",
        "  ORDER BY\n",
        "    Run_Timestamp DESC\n",
        "  LIMIT 1\n",
        ")\n",
        "SELECT\n",
        "  d.table_name,\n",
        "  d.check_name,\n",
        "  d.check_type,\n",
        "  d.status,\n",
        "  d.actual_value,\n",
        "  d.threshold_value,\n",
        "  d.message\n",
        "FROM\n",
        "  latest l\n",
        "    JOIN {silver_catalog}.{silver_schema}.`_validation_check_detail` d\n",
        "      ON d.run_id = l.run_id\n",
        "WHERE\n",
        "  d.check_type IN ('FK', 'INTEGRATION')\n",
        "ORDER BY\n",
        "  d.table_name,\n",
        "  d.check_name"
      ]
    }
  ],
