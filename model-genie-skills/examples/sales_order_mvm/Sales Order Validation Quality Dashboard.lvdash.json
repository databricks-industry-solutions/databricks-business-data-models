{
  "datasets": [
    {
      "name": "ds_health_banner",
      "displayName": "Overall Health Banner",
      "queryLines": [
        "SELECT Overall_Grade, Run_Timestamp, Total_Entities, Entities_Grade_A, Drift_Alerts_Count FROM manufacturing_silver_vibe.sales_order._validation_run ORDER BY Run_Timestamp DESC LIMIT 1"
      ]
    },
    {
      "name": "ds_entity_grades",
      "displayName": "Entity Grade Table",
      "queryLines": [
        "SELECT Table_Name, Table_Type, Tier, Row_Count, Grade, Grade_Delta, Pk_Duplicate_Count, Fk_Orphan_Rate_Pct, Key_Column_Pop_Pct, Drift_Columns_Count, Integration_Pass, Known_Gaps_Count FROM manufacturing_silver_vibe.sales_order._validation_table_result WHERE Run_Id = (SELECT Run_Id FROM manufacturing_silver_vibe.sales_order._validation_run ORDER BY Run_Timestamp DESC LIMIT 1) ORDER BY CASE Grade WHEN 'F' THEN 1 WHEN 'D' THEN 2 WHEN 'C' THEN 3 WHEN 'B' THEN 4 WHEN 'B+' THEN 5 WHEN 'A' THEN 6 END, Tier, Table_Name"
      ]
    },
    {
      "name": "ds_grade_distribution",
      "displayName": "Grade Distribution",
      "queryLines": [
        "SELECT Grade, COUNT(*) AS Entity_Count FROM manufacturing_silver_vibe.sales_order._validation_table_result WHERE Run_Id = (SELECT Run_Id FROM manufacturing_silver_vibe.sales_order._validation_run ORDER BY Run_Timestamp DESC LIMIT 1) GROUP BY Grade"
      ]
    },
    {
      "name": "ds_grade_trend",
      "displayName": "Overall Grade Over Time",
      "queryLines": [
        "SELECT DATE(Run_Timestamp) AS Run_Date, Overall_Grade, Entities_Grade_A, Entities_Grade_B_Plus + Entities_Grade_B AS Entities_Grade_B_Any, Entities_Grade_C_Or_Below, Drift_Alerts_Count FROM manufacturing_silver_vibe.sales_order._validation_run ORDER BY Run_Timestamp"
      ]
    },
    {
      "name": "ds_row_count_trend",
      "displayName": "Row Count Trend",
      "queryLines": [
        "SELECT r.Run_Timestamp, t.Table_Name, t.Row_Count FROM manufacturing_silver_vibe.sales_order._validation_table_result t JOIN manufacturing_silver_vibe.sales_order._validation_run r ON t.Run_Id = r.Run_Id ORDER BY t.Table_Name, r.Run_Timestamp"
      ]
    },
    {
      "name": "ds_gap_summary",
      "displayName": "Gap Registry Summary",
      "queryLines": [
        "SELECT Priority, Status, COUNT(*) AS Gap_Count FROM manufacturing_silver_vibe.sales_order._gap_registry WHERE Status NOT IN ('RESOLVED') GROUP BY Priority, Status ORDER BY CASE Priority WHEN 'P0' THEN 1 WHEN 'P1' THEN 2 WHEN 'P2' THEN 3 WHEN 'P3' THEN 4 END, Status"
      ]
    },
    {
      "name": "ds_gap_detail",
      "displayName": "Prioritized Gap Detail",
      "queryLines": [
        "SELECT Priority, Table_Name, Column_Name, Gap_Description, Gap_Type, Status, Unblock_Action, Impact_Description FROM manufacturing_silver_vibe.sales_order._gap_registry WHERE Status NOT IN ('RESOLVED','DEFERRED') ORDER BY CASE Priority WHEN 'P0' THEN 1 WHEN 'P1' THEN 2 WHEN 'P2' THEN 3 WHEN 'P3' THEN 4 END, Created_Date"
      ]
    },
    {
      "name": "ds_integration_checks",
      "displayName": "Integration Health Checks",
      "queryLines": [
        "SELECT Table_Name, Check_Name, Status, Actual_Value, Message FROM manufacturing_silver_vibe.sales_order._validation_check_detail WHERE Run_Id = (SELECT Run_Id FROM manufacturing_silver_vibe.sales_order._validation_run ORDER BY Run_Timestamp DESC LIMIT 1) AND Check_Type = 'INTEGRATION' ORDER BY CASE Status WHEN 'FAIL' THEN 1 WHEN 'WARN' THEN 2 ELSE 3 END, Table_Name"
      ]
    },
    {
      "name": "ds_fk_orphan_rates",
      "displayName": "FK Orphan Rates",
      "queryLines": [
        "SELECT Check_Name AS Relationship, CAST(Actual_Value AS DECIMAL(7,4)) AS Orphan_Rate_Pct, Status FROM manufacturing_silver_vibe.sales_order._validation_check_detail WHERE Run_Id = (SELECT Run_Id FROM manufacturing_silver_vibe.sales_order._validation_run ORDER BY Run_Timestamp DESC LIMIT 1) AND Check_Type = 'FK' ORDER BY CAST(Actual_Value AS DECIMAL(7,4)) DESC"
      ]
    }
  ],
